    $('#mlist').innerHTML=ids.map(function(i){return '<option value="'+esc(i)+'">'}).join('');
    note('Моделей в списке: '+ids.length+'. Очистите поле «Модель» и начните вводить название, например nemotron.','ok');
  }catch(e){note(niceErr(e),'bad')}
};
$('#sExp').onclick=function(){
  var b=new Blob([JSON.stringify(S,function(k,v){return k==='keys'?undefined:v})],{type:'application/json'});
  var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='chat-backup.json';document.body.appendChild(a);a.click();document.body.removeChild(a);
};
$('#sImp').onclick=function(){$('#fImp').click()};
$('#fImp').onchange=function(e){
  var f=e.target.files[0];if(!f)return;
  var r=new FileReader();
  r.onload=function(){
    try{
      var d=JSON.parse(r.result);if(!d.cfg||!d.chats)throw 0;
      var keys=S.cfg.keys;S=norm(d);S.cfg.keys=keys;save();fillSet();render(true);toast('Копия загружена');
    }catch(x){toast('Не удалось прочитать файл копии')}
  };
  r.readAsText(f);e.target.value='';
};
$('#sClr').onclick=function(){
  if(busy)return toast('Дождитесь окончания ответа');
  if(!confirm('Удалить все чаты? Память и настройки останутся.'))return;
  S.chats=[];S.cur=null;save();render();toast('Чаты удалены');
};

if(!storageOK)$('#nostore').style.display='block';
setBusy();render(true);
if(!curKey())setTimeout(function(){if(!cur()||!cur().msgs.length)render()},0);
})();
</script>
</body>
</html>
