async function run(c,skipTags){
  var a={role:'assistant',content:'',reasoning:''},errText='';
  c.msgs.push(a);errBox='';busy=true;ctrl=new AbortController();setBusy();render(true);save();bump();
  try{
    var sys=S.cfg.sys+memText()+(S.cfg.auto?AUTO:'');
    var hist=c.msgs.slice(0,-1).map(function(m){return{role:m.role,content:m.role==='user'?m.content:parts(m).text}}).filter(function(m){return m.content});
    var body={model:S.cfg.model,stream:true,messages:[{role:'system',content:sys}].concat(hist)};
    if(S.cfg.temp!==''&&!isNaN(+S.cfg.temp))body.temperature=+S.cfg.temp;
    if(S.cfg.max!==''&&+S.cfg.max>0)body.max_tokens=Math.round(+S.cfg.max);
    var r=await fetch(base()+'/chat/completions',{method:'POST',signal:ctrl.signal,headers:hdrs(),body:JSON.stringify(body)});
    if(!r.ok)throw await httpErr(r);
    var rd=r.body.getReader(),dec=new TextDecoder(),buf='';
    while(true){
      var x=await rd.read();if(x.done)break;
      buf+=dec.decode(x.value,{stream:true});
      var lines=buf.split('\n');buf=lines.pop();
      for(var i=0;i<lines.length;i++){
        var l=lines[i].trim();if(l.indexOf('data:')!==0)continue;
        var p=l.slice(5).trim();if(!p||p==='[DONE]')continue;
        var j;try{j=JSON.parse(p)}catch(er){continue}
        if(j.error)throw new Error(j.error.message||'Ошибка провайдера');
        var dl=(j.choices&&j.choices[0]&&j.choices[0].delta)||{};
        if(dl.content)a.content+=dl.content;
        var rs=dl.reasoning_content||dl.reasoning;if(typeof rs==='string')a.reasoning+=rs;
      }
      paint(c);
    }
    if(!a.content&&!a.reasoning)errText='Модель вернула пустой ответ. Повторите запрос.';
    else if(!a.content)errText='Модель только рассуждала и не дала ответа. Повторите запрос или увеличьте лимит ответа в настройках.';
  }catch(e){
    if(e.name!=='AbortError')errText=niceErr(e);
  }
  busy=false;ctrl=null;setBusy();
  if(!a.content){
    var k=c.msgs.indexOf(a);if(k>=0)c.msgs.splice(k,1);
    if(errText)errBox=errText;
  }else{
    if(errText)a.err=errText;
    if(!skipTags&&S.cfg.auto){var ad=harvest(a.content);if(ad.length)toast('Запомнил: '+short(ad.join('; ')))}
  }
  save();render();
}
