<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
<meta name="color-scheme" content="dark light">
<title>Мой чат</title>
<style>
:root{--bg:#12161f;--panel:#181d29;--raise:#212838;--line:#2b3347;--text:#e8ebf2;--mute:#9aa3b8;--acc:#e3a857;--accfg:#1d1405;--me:#273049;--code:#0d1017;--err:#ef8a80;--ok:#7bc47f}
@media (prefers-color-scheme: light){:root{--bg:#f3f5f9;--panel:#fff;--raise:#e9edf5;--line:#d5dbe6;--text:#1a2030;--mute:#5a6680;--acc:#9a5a00;--accfg:#fff;--me:#dce5f5;--code:#eef1f7;--err:#b3261e;--ok:#2c7a31}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{display:flex;flex-direction:column;height:100vh;height:100dvh;overflow:hidden;background:var(--bg);color:var(--text);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
a{color:var(--acc)}
header{flex:none;display:flex;align-items:center;gap:2px;padding:6px 6px;background:var(--panel);border-bottom:1px solid var(--line)}
.ib{flex:none;width:44px;height:44px;border-radius:12px;font-size:21px;display:flex;align-items:center;justify-content:center}
.ib:active,.acts button:active,.row .t:active{background:var(--raise)}
.ttl{flex:1;min-width:0;padding:0 4px}
.ttl b{display:block;font-size:16px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ttl span{display:block;font-size:12px;color:var(--mute);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#msgs{flex:1;min-height:0;overflow-y:auto;padding:16px 14px 10px;-webkit-overflow-scrolling:touch}
.wrap{max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:20px}
.msg{display:flex;flex-direction:column;min-width:0}
.msg.user{align-items:flex-end}
.msg.user .bub{background:var(--me);border-radius:18px 18px 4px 18px;padding:9px 14px;max-width:90%;white-space:pre-wrap;overflow-wrap:anywhere}
.msg.assistant .bub{font-family:"Noto Serif",Georgia,"Times New Roman",serif;font-size:16.5px;line-height:1.65;overflow-wrap:anywhere;min-width:0;max-width:100%}
.bub>:first-child{margin-top:0}.bub>:last-child{margin-bottom:0}
.bub p{margin:.65em 0}
.bub h2,.bub h3,.bub h4,.bub h5,.bub h6{font-family:system-ui,sans-serif;line-height:1.3;margin:1.1em 0 .4em}
.bub h2{font-size:1.25em}.bub h3{font-size:1.12em}.bub h4,.bub h5,.bub h6{font-size:1em}
.bub ul,.bub ol{margin:.5em 0;padding-left:1.4em}
.bub li{margin:.2em 0}
.bub blockquote{margin:.7em 0;padding:.1em 0 .1em 12px;border-left:3px solid var(--line);color:var(--mute)}
.bub hr{border:0;border-top:1px solid var(--line);margin:1em 0}
.bub code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.88em}
.bub :not(pre)>code{background:var(--raise);padding:1px 5px;border-radius:5px}
.cb{margin:.8em 0;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--code)}
.ch{display:flex;justify-content:space-between;align-items:center;padding:3px 6px 3px 12px;border-bottom:1px solid var(--line);font:12px system-ui,sans-serif;color:var(--mute)}
.cp{padding:6px 8px;border-radius:6px;font-size:12px;color:var(--mute)}
.cb pre{margin:0;padding:10px 12px;overflow-x:auto;font-size:14px;line-height:1.5}
.tbl{overflow-x:auto;margin:.8em 0}
.tbl table{border-collapse:collapse;font:14.5px/1.4 system-ui,sans-serif}
.tbl th,.tbl td{border:1px solid var(--line);padding:6px 10px;text-align:left;vertical-align:top}
.tbl th{background:var(--raise)}
details.th{margin:0 0 10px;font:14px/1.5 system-ui,sans-serif;color:var(--mute);border-left:2px solid var(--line);padding-left:10px}
details.th summary{padding:3px 0;cursor:pointer}
details.th div{white-space:pre-wrap;margin-top:4px;max-height:45vh;overflow:auto}
.dots{color:var(--mute)}
.err{margin-top:8px;padding:9px 12px;border-radius:10px;border:1px solid var(--err);color:var(--err);font:14.5px/1.45 system-ui,sans-serif}
.acts{display:flex;flex-wrap:wrap;gap:2px;margin-top:3px}
.acts button{padding:7px 9px;border-radius:8px;font-size:13px;color:var(--mute)}
.hint{max-width:440px;margin:6vh auto 0;color:var(--mute)}
.hint h2{margin:0 0 10px;font-size:20px;color:var(--text)}
.hint ol{padding-left:1.3em}.hint li{margin:.5em 0}
.hint .warn{color:var(--err)}
.pri,.sec{padding:11px 16px;border-radius:12px;font-weight:600}
.pri{background:var(--acc);color:var(--accfg)}
.sec{border:1px solid var(--line)}
.sec:active{background:var(--raise)}
#comp{flex:none;padding:6px 10px 10px}
#edit{display:none;max-width:760px;margin:0 auto 6px;padding:0 6px;font-size:13px;color:var(--mute);justify-content:space-between;align-items:center}
#edit.on{display:flex}
#edit button{padding:6px 8px;color:var(--acc)}
.box{max-width:760px;margin:0 auto;display:flex;align-items:flex-end;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:24px;padding:5px 5px 5px 16px}
.box:focus-within{border-color:var(--acc)}
#inp{flex:1;min-width:0;border:0;background:none;color:var(--text);font:inherit;resize:none;max-height:160px;min-height:34px;padding:6px 0;outline:none}
#go{flex:none;width:42px;height:42px;border-radius:50%;background:var(--acc);color:var(--accfg);font-size:20px;font-weight:700}
#drawer,#sheet{position:fixed;left:0;right:0;top:0;bottom:0;display:none;z-index:5}
#drawer.on,#sheet.on{display:block}
.back{position:absolute;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.5)}
.side{position:absolute;top:0;bottom:0;left:0;width:min(86vw,350px);background:var(--panel);border-right:1px solid var(--line);display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.side .top{padding:10px;display:flex;flex-direction:column;gap:8px}
.side .pri{width:100%}
input,textarea{font:inherit;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px;width:100%}
input:focus,textarea:focus,button:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
#list{flex:1;overflow-y:auto;padding:0 6px 10px}
.row{display:flex;align-items:center;border-radius:10px}
.row.cur{background:var(--raise)}
.row .t{flex:1;min-width:0;text-align:left;padding:11px 10px;border-radius:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .x{flex:none;width:38px;height:40px;color:var(--mute)}
.none{padding:16px;color:var(--mute);text-align:center}
.pane{position:absolute;left:0;right:0;top:0;bottom:0;background:var(--bg);overflow-y:auto;padding-top:env(safe-area-inset-top,0px);padding-bottom:calc(30px + env(safe-area-inset-bottom,0px))}
.phead{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--panel);border-bottom:1px solid var(--line)}
.phead h2{margin:0;font-size:18px}
.in{max-width:560px;margin:0 auto;padding:4px 14px}
.in h3{margin:26px 0 4px;font-size:17px}
.in label{display:block;margin:14px 0 5px;font-size:14px;font-weight:600}
.in small,.note{display:block;margin-top:6px;font-size:13px;line-height:1.45;color:var(--mute)}
.note{white-space:pre-line}.note.ok{color:var(--ok)}.note.bad{color:var(--err)}
.chips,.btns,.two,.r2{display:flex;gap:8px;flex-wrap:wrap}
.chips button{padding:8px 12px;border-radius:18px;border:1px solid var(--line);font-size:14px}
.chips button.on{border-color:var(--acc);color:var(--acc)}
.btns{margin-top:12px}
.two>div{flex:1;min-width:130px}
.r2{flex-wrap:nowrap}.r2 button{flex:none}
.danger{color:var(--err)}
.chk{display:flex!important;align-items:center;gap:10px}
.chk input{width:20px;height:20px;flex:none}
#mem{list-style:none;margin:10px 0;padding:0}
#mem li{display:flex;align-items:flex-start;gap:6px;padding:8px 4px 8px 12px;margin-bottom:6px;background:var(--panel);border:1px solid var(--line);border-radius:10px}
#mem li span{flex:1;min-width:0;overflow-wrap:anywhere}
#mem li button{flex:none;width:34px;height:30px;color:var(--mute)}
#mem li.empty{color:var(--mute);border-style:dashed}
#toast{position:fixed;left:50%;bottom:calc(92px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);max-width:88vw;padding:10px 16px;border-radius:12px;background:var(--raise);border:1px solid var(--line);font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:9;text-align:center}
#toast.on{opacity:1}
#nostore{display:none;padding:8px 14px;background:var(--err);color:#fff;font-size:13px;line-height:1.4}
</style>
</head>
<body>
<div id="nostore">Браузер не разрешает этой странице сохранять данные: чаты и память пропадут после закрытия. Откройте файл через Chrome по адресу file:///sdcard/Download/chat2.html</div>
<header>
  <button class="ib" id="bMenu" aria-label="Чаты">&#9776;</button>
  <div class="ttl"><b id="ttl">Новый чат</b><span id="sub"></span></div>
  <button class="ib" id="bNewTop" aria-label="Новый чат">&#65291;</button>
  <button class="ib" id="bSet" aria-label="Настройки">&#9881;&#xFE0E;</button>
</header>
<div id="msgs"><div class="wrap" id="wrap"></div></div>
<div id="comp">
  <div id="edit"><span>Изменение сообщения</span><button id="eCancel">Отмена</button></div>
  <div class="box">
    <textarea id="inp" rows="1" placeholder="Напишите сообщение"></textarea>
    <button id="go" aria-label="Отправить">&#8593;</button>
  </div>
</div>

<div id="drawer">
  <div class="back" id="dBack"></div>
  <div class="side">
    <div class="top">
      <button class="pri" id="bNew">Новый чат</button>
      <input id="dq" type="search" placeholder="Поиск по чатам" autocomplete="off">
    </div>
    <div id="list"></div>
  </div>
</div>

<div id="sheet">
  <div class="pane">
    <div class="phead"><h2>Настройки</h2><button class="pri" id="sDone">Готово</button></div>
    <div class="in">
      <h3>Подключение</h3>
      <div class="chips" id="presets">
        <button data-p="or">OpenRouter, бесплатно</button>
        <button data-p="nv">NVIDIA</button>
      </div>
      <label for="cUrl">Адрес API</label>
      <input id="cUrl" autocomplete="off" autocapitalize="off" spellcheck="false">
      <label for="cKey">Ключ API</label>
      <div class="r2"><input id="cKey" type="password" autocomplete="off" autocapitalize="off" spellcheck="false"><button class="sec" id="kEye" type="button">Показать</button></div>
      <small>Ключ хранится только в этом браузере и отправляется только на указанный адрес.</small>
      <label for="cModel">Модель</label>
      <input id="cModel" list="mlist" autocomplete="off" autocapitalize="off" spellcheck="false">
      <datalist id="mlist"></datalist>
      <div class="btns"><button class="sec" id="bTest">Проверить подключение</button><button class="sec" id="bModels">Список моделей</button></div>
      <div class="note" id="tres"></div>
      <small id="hintProv"></small>

      <h3>Ассистент</h3>
      <label for="cSys">Инструкция</label>
      <textarea id="cSys" rows="4"></textarea>
      <div class="two">
        <div><label for="cTemp">Температура</label><input id="cTemp" inputmode="decimal" placeholder="по умолчанию"></div>
        <div><label for="cMax">Лимит ответа, токенов</label><input id="cMax" inputmode="numeric" placeholder="по умолчанию"></div>
      </div>

      <h3>Память</h3>
      <small>Эти факты отправляются модели в каждом чате. Добавить факт можно здесь или фразой «запомни: …» в чате.</small>
      <label class="chk" for="cAuto"><input type="checkbox" id="cAuto"> Запоминать автоматически</label>
      <ul id="mem"></ul>
      <div class="r2"><input id="mNew" placeholder="Новый факт" autocomplete="off"><button class="sec" id="mAdd" type="button">Добавить</button></div>
      <small>Не записывайте сюда пароли и личные данные: на бесплатных серверах запросы могут сохраняться.</small>

      <h3>Данные</h3>
      <div class="btns">
        <button class="sec" id="sExp">Скачать копию</button>
        <button class="sec" id="sImp">Загрузить копию</button>
        <button class="sec danger" id="sClr">Удалить все чаты</button>
      </div>
      <small>Копия содержит чаты, память и настройки, но не содержит ключи.</small>
      <input type="file" id="fImp" accept=".json,application/json" hidden>
    </div>
  </div>
</div>
<div id="toast"></div>

<script>
(function(){
'use strict';
var $=function(s){return document.querySelector(s)};

/*MD-START*/
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function inline(s){
  var codes=[];
  s=s.replace(/`([^`\n]+)`/g,function(_,c){codes.push(c);return '\u0000'+(codes.length-1)+'\u0000'});
  s=s.replace(/\*\*([^*\n]+)\*\*/g,'<b>$1</b>');
  s=s.replace(/(^|[^*\w])\*([^*\n]+)\*(?!\*)/g,'$1<i>$2</i>');
  s=s.replace(/\[([^\]\n]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
  s=s.replace(/(^|[\s(])(https?:\/\/[^\s<]*[^\s<.,;:!?)])/g,'$1<a href="$2" target="_blank" rel="noopener noreferrer">$2</a>');
  return s.replace(/\u0000(\d+)\u0000/g,function(_,i){return '<code>'+codes[+i]+'</code>'});
}
function codeBlock(code,lang){
  return '<div class="cb"><div class="ch"><span>'+esc(lang||'код')+'</span><button class="cp" type="button">Копировать</button></div><pre><code>'+esc(code)+'</code></pre></div>';
}
function isSep(l){return /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)*\|?\s*$/.test(l)}
function cells(l){l=l.trim();if(l.charAt(0)==='|')l=l.slice(1);if(l.charAt(l.length-1)==='|')l=l.slice(0,-1);return l.split('|').map(function(x){return x.trim()})}
function table(h,rows){
  var t='<div class="tbl"><table><thead><tr>'+h.map(function(c){return '<th>'+inline(esc(c))+'</th>'}).join('')+'</tr></thead><tbody>';
  rows.forEach(function(r){t+='<tr>'+r.map(function(c){return '<td>'+inline(esc(c))+'</td>'}).join('')+'</tr>'});
  return t+'</tbody></table></div>';
}
function buildList(items){
  var h='',st=[];
  items.forEach(function(it){
    while(st.length&&it.indent<st[st.length-1].indent){h+='</li></'+st.pop().tag+'>'}
    var top=st[st.length-1],body=inline(esc(it.text)).replace(/\n/g,'<br>');
    if(!top||it.indent>top.indent){h+='<'+it.tag+'><li>'+body;st.push({indent:it.indent,tag:it.tag})}
    else{h+='</li><li>'+body}
  });
  while(st.length)h+='</li></'+st.pop().tag+'>';
  return h;
}
function md(src){
  var L=src.replace(/\r/g,'').replace(/\t/g,'  ').split('\n'),out=[],i=0,m;
  var blockStart=/^\s*(```|#{1,6}\s|>|[-*+]\s|\d+[.)]\s|\|)/,hr=/^\s*([-*_])(\s*\1){2,}\s*$/,li=/^(\s*)([-*+]|\d+[.)])\s+(.*)$/;
  while(i<L.length){
    var l=L[i];
    if((m=l.match(/^\s*```\s*([\w+#.-]*)/))){
      var buf=[];i++;
      while(i<L.length&&!/^\s*```/.test(L[i])){buf.push(L[i]);i++}
      i++;out.push(codeBlock(buf.join('\n'),m[1]));continue;
    }
    if(/^\s*$/.test(l)){i++;continue}
    if((m=l.match(/^(#{1,6})\s+(.*)$/))){var n=Math.min(m[1].length+1,6);out.push('<h'+n+'>'+inline(esc(m[2]))+'</h'+n+'>');i++;continue}
    if(hr.test(l)){out.push('<hr>');i++;continue}
    if(/^\s*>/.test(l)){var q=[];while(i<L.length&&/^\s*>/.test(L[i])){q.push(L[i].replace(/^\s*>\s?/,''));i++}out.push('<blockquote>'+md(q.join('\n'))+'</blockquote>');continue}
    if(l.indexOf('|')>=0&&i+1<L.length&&isSep(L[i+1])){
      var head=cells(l),rows=[];i+=2;
      while(i<L.length&&L[i].indexOf('|')>=0&&!/^\s*$/.test(L[i])){rows.push(cells(L[i]));i++}
      out.push(table(head,rows));continue;
    }
    if(li.test(l)){
      var items=[];
      while(i<L.length){
        var lm=L[i].match(li);
        if(lm){items.push({indent:lm[1].length,tag:/\d/.test(lm[2])?'ol':'ul',text:lm[3]});i++;continue}
        if(items.length&&/^\s{2,}\S/.test(L[i])){items[items.length-1].text+='\n'+L[i].trim();i++;continue}
        if(/^\s*$/.test(L[i])){var j=i;while(j<L.length&&/^\s*$/.test(L[j]))j++;if(j<L.length&&li.test(L[j])){i=j;continue}}
        break;
      }
      out.push(buildList(items));continue;
    }
    var p=[l];i++;
    while(i<L.length&&!/^\s*$/.test(L[i])&&!blockStart.test(L[i])&&!hr.test(L[i])){p.push(L[i]);i++}
    out.push('<p>'+inline(esc(p.join('\n'))).replace(/\n/g,'<br>')+'</p>');
  }
  return out.join('');
}
function cleanTags(t){
  t=t.replace(/<remember>[\s\S]*?<\/remember>/g,'');
  var o=t.indexOf('<remember>');if(o>=0)t=t.slice(0,o);
  var i=t.lastIndexOf('<');
  if(i>=0&&t.length-i<12){var tail=t.slice(i);if('<remember>'.indexOf(tail)===0||'<think>'.indexOf(tail)===0)t=t.slice(0,i)}
  return t;
}
function parts(m){
  var c=m.content||'',th=m.reasoning||'';
  c=c.replace(/<think>([\s\S]*?)<\/think>/g,function(_,x){th+=(th?'\n':'')+x;return ''});
  var o=c.indexOf('<think>');
  if(o>=0){th+=(th?'\n':'')+c.slice(o+7);c=c.slice(0,o)}
  var e=c.indexOf('</think>');
  if(e>=0){th+=(th?'\n':'')+c.slice(0,e);c=c.slice(e+8)}
  return{think:th.trim(),text:cleanTags(c).replace(/^\s+/,'').replace(/\s+$/,'')};
}
/*MD-END*/

/* ---------- состояние ---------- */
var KEY='shell_v2',OLD='my_shell_v1';
var PRESETS={
  or:{url:'https://openrouter.ai/api/v1',model:'nvidia/nemotron-3-ultra-550b-a55b:free'},
  nv:{url:'https://integrate.api.nvidia.com/v1',model:'nvidia/nemotron-3-ultra-550b-a55b'}
};
var AUTO='\n\nПамять: если пользователь просит что-то запомнить или сообщает устойчивый факт о себе (имя, город, предпочтения, цели, привычки), добавь в самый конец ответа тег <remember>короткий факт одной строкой</remember>. Не добавляй тег для разовых деталей и не упоминай этот тег в тексте ответа.';
var storageOK=true;
try{localStorage.setItem('_t','1');localStorage.removeItem('_t')}catch(e){storageOK=false}

function host(u){try{return new URL(u).hostname}catch(e){return String(u||'')}}
function def(){return{v:2,cfg:{url:PRESETS.or.url,model:PRESETS.or.model,sys:'Ты умный и дружелюбный ассистент. Отвечай по-русски, если не просят иначе. Пиши ясно и по делу.',temp:'',max:'',auto:true,keys:{}},mem:[],chats:[],cur:null,stats:{day:'',n:0}}}
function fixChat(c){c.msgs=(c.msgs||[]).filter(function(m){return m.role==='user'||(m.content&&m.content.indexOf('\u26A0')!==0)});return c}
function norm(d){
  var b=def();
  d.cfg=d.cfg||{};for(var k in b.cfg)if(!(k in d.cfg))d.cfg[k]=b.cfg[k];
  d.cfg.keys=d.cfg.keys||{};d.mem=d.mem||[];d.chats=(d.chats||[]).map(fixChat);d.stats=d.stats||b.stats;
  if(d.cur&&!d.chats.some(function(c){return c.id===d.cur}))d.cur=null;
  return d;
}
function load(){
  try{var d=JSON.parse(localStorage.getItem(KEY));if(d&&d.cfg)return norm(d)}catch(e){}
  var s=def();
  try{
    var o=JSON.parse(localStorage.getItem(OLD));
    if(o&&o.cfg){
