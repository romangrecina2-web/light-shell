  if(!curKey()){toast('Сначала добавьте ключ в настройках');openSet();return}
  var c=cur()||newChat(),skip=false;
  var mm=t.match(/^запомни[:,]?\s+([\s\S]+)/i);
  if(mm){skip=true;if(addFact(mm[1]))toast('Запомнил: '+short(mm[1].trim()))}
  if(editIdx!==null){c.msgs=c.msgs.slice(0,editIdx);endEdit()}
  c.msgs.push({role:'user',content:t});
  if(c.title==='Новый чат'||c.msgs.length===1)c.title=short(t.replace(/\s+/g,' ')).slice(0,40);
  c.ts=Date.now();inp.value='';autosize();stuck=true;
  run(c,skip);
}
function regen(){
