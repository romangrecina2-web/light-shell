function httpErr(r){
  return r.text().then(function(t){return t},function(){return ''}).then(function(t){
    var msg=t;try{var j=JSON.parse(t);msg=(j.error&&(j.error.message||j.error))||j.message||j.detail||t}catch(e){}
    if(typeof msg!=='string')msg=JSON.stringify(msg);
    var e=new Error(msg.slice(0,300));e.status=r.status;return e;
  });
}
function niceErr(e){
  var s=e.status,m=e.message||'';
  if(!s){
    if(/failed to fetch|load failed|networkerror/i.test(m))
      return host(S.cfg.url).indexOf('nvidia')>=0
        ?'NVIDIA не разрешает запросы из браузера (защита CORS), поэтому этот адрес здесь не работает. Выберите в настройках OpenRouter: там та же модель и бесплатный ключ.'
        :'Не удалось связаться с сервером. Проверьте интернет и адрес API. Если всё верно, сервер мог запретить запросы из браузера (CORS).';
    return m;
  }
  if(s===401||s===403)return 'Ключ не подошёл ('+s+'). Проверьте, что он вставлен целиком и выдан для этого адреса.';
  if(s===402)return 'Не хватает средств на балансе (402). На OpenRouter отрицательный баланс блокирует даже бесплатные модели.';
  if(s===404){
    if(/data policy|guardrail/i.test(m))return 'OpenRouter не нашёл бесплатный сервер из-за настроек приватности. Откройте openrouter.ai/settings/privacy, разрешите бесплатные модели и повторите.';
    return 'Не найдено (404). Проверьте адрес API и название модели.';
  }
  if(s===429)return 'Лимит запросов исчерпан (429). У бесплатных моделей OpenRouter это обычно 20 в минуту и 50 в день. Подождите и повторите.';
  if(s>=500)return 'Сервер модели сейчас недоступен ('+s+'). Попробуйте через минуту.';
  return 'Ошибка '+s+': '+m;
}
function send(){
  if(busy){if(ctrl)ctrl.abort();return}
